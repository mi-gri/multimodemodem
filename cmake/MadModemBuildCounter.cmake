# Run at build time (cmake -P). Writes the build number source file.
# Inputs: SOURCE_DIR, BINARY_DIR, OUTPUT, FIXED_NUMBER, GIT_EXECUTABLE.
#  - FIXED_NUMBER != 0 (distribution build): that number, no counting.
#  - otherwise: the local counter in BINARY_DIR goes up by one whenever a
#    source file changed since the last counted build, and the short Git
#    commit is recorded on every build ("+" when tracked files are modified).
set(_counter_file "${BINARY_DIR}/madmodem_build_counter.txt")
set(_stamp_file "${BINARY_DIR}/madmodem_build_counter.stamp")

function(_write_number number revision)
    set(_content "// Generated by cmake/MadModemBuildCounter.cmake\n#include \"utils/BuildNumber.h\"\nconst char *MadModemBuild::number() { return \"${number}\"; }\nconst char *MadModemBuild::revision() { return \"${revision}\"; }\n")
    set(_old "")
    if(EXISTS "${OUTPUT}")
        file(READ "${OUTPUT}" _old)
    endif()
    if(NOT _old STREQUAL _content)
        file(WRITE "${OUTPUT}" "${_content}")
    endif()
endfunction()

if(NOT FIXED_NUMBER STREQUAL "" AND NOT FIXED_NUMBER STREQUAL "0")
    _write_number("${FIXED_NUMBER}" "")
    return()
endif()

set(_count 0)
if(EXISTS "${_counter_file}")
    file(READ "${_counter_file}" _count)
    string(STRIP "${_count}" _count)
    if(NOT _count MATCHES "^[0-9]+$")
        set(_count 0)
    endif()
endif()

set(_changed FALSE)
if(_count EQUAL 0 OR NOT EXISTS "${_stamp_file}" OR NOT EXISTS "${OUTPUT}")
    set(_changed TRUE)
else()
    file(GLOB_RECURSE _sources LIST_DIRECTORIES false
        "${SOURCE_DIR}/*.cpp" "${SOURCE_DIR}/*.h" "${SOURCE_DIR}/*.hpp" "${SOURCE_DIR}/*.c"
        "${SOURCE_DIR}/*.ui" "${SOURCE_DIR}/*.qrc" "${SOURCE_DIR}/*.qml" "${SOURCE_DIR}/*.ini"
        "${SOURCE_DIR}/CMakeLists.txt" "${SOURCE_DIR}/*.cmake")
    foreach(_source IN LISTS _sources)
        string(FIND "${_source}" "${BINARY_DIR}/" _in_build)
        if(NOT _in_build EQUAL 0 AND NOT _source MATCHES "/build[^/]*/" AND
           "${_source}" IS_NEWER_THAN "${_stamp_file}")
            set(_changed TRUE)
            break()
        endif()
    endforeach()
endif()

if(_changed)
    math(EXPR _count "${_count} + 1")
    file(WRITE "${_counter_file}" "${_count}\n")
    file(TOUCH "${_stamp_file}")
    message(STATUS "MadModem local build ${_count}")
endif()

set(_revision "")
if(GIT_EXECUTABLE)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --short=7 HEAD
        OUTPUT_VARIABLE _revision OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE _git_result ERROR_QUIET)
    if(NOT _git_result EQUAL 0 OR NOT _revision MATCHES "^[0-9a-f]+$")
        set(_revision "")
    else()
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" diff --quiet HEAD --
            RESULT_VARIABLE _dirty ERROR_QUIET)
        if(_dirty EQUAL 1)
            string(APPEND _revision "+")
        endif()
    endif()
endif()
_write_number("${_count}" "${_revision}")
